COMPOSE_PROJECT_NAME=taco-cloud

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=tacocloud
POSTGRES_USER=taco
POSTGRES_PASSWORD=taco_dev_password
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_VOLUME_NAME=taco-cloud-postgres-data

PGADMIN_IMAGE=dpage/pgadmin4:8.14
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin_dev_password
PGADMIN_PORT=5050
PGADMIN_BIND_ADDRESS=127.0.0.1
PGADMIN_VOLUME_NAME=taco-cloud-pgadmin-data
